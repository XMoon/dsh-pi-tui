{
  "name": "@dsh-pi-tui/tui-app",
  "version": "0.1.0",
  "description": "The dsh-pi-tui bundle: a TUI surface for DeepSeek Harness profiles (dsh --profile tui)",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./startup": {
      "types": "./src/startup.ts",
      "default": "./src/startup.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-pi-tui/pi-tui": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.5",
    "@deepseek-ai/cordis": "^4.0.0-rc.7",
    "chalk": "^5.4.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@xterm/headless": "5.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  }
}
