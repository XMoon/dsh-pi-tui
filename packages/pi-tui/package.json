	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs",
				"default": "./dist/index.mjs"
			}
		},
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --test test/*.test.ts",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@xterm/headless": "5.5.0",
