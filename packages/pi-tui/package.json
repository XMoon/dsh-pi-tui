	"license": "MIT",
	"author": "Moonshot AI",
	"homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/pi-tui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MoonshotAI/kimi-code.git",
		"directory": "packages/pi-tui",
