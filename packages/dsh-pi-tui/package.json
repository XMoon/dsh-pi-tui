{
  "name": "@xmoon76/dsh-pi-tui",
  "version": "0.2.0",
  "description": "The dsh-pi-tui bundle: a TUI surface for DeepSeek Harness profiles (dsh --profile pi-tui)",
  "license": "MIT",
  "author": "XMoon <xmoonox@gmail.com>",
  "homepage": "https://github.com/XMoon/dsh-pi-tui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XMoon/dsh-pi-tui.git",
    "directory": "packages/dsh-pi-tui"
  },
  "bugs": {
    "url": "https://github.com/XMoon/dsh-pi-tui/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tui",
    "terminal",
    "cordis",
    "cli"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./startup": {
      "types": "./dist/startup.d.mts",
      "default": "./dist/startup.mjs"
    },
    "./extensions": {
      "types": "./dist/extensions.d.mts",
      "default": "./dist/extensions.mjs"
    },
    "./extensions/advanced": {
      "types": "./dist/extension/advanced.d.mts",
      "default": "./dist/extension/advanced.mjs"
    },
    "./extensions/unstable": {
      "types": "./dist/extension/unstable.d.mts",
      "default": "./dist/extension/unstable.mjs"
    },
    "./builtins": {
      "types": "./dist/builtins.d.mts",
      "default": "./dist/builtins.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^15.0.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-goal": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-retry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-workflow": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@xmoon76/pi-tui": "workspace:^0.84.3",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@xterm/headless": "5.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsdown": "0.22.0",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-goal": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-workflow": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-retry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:package": "pnpm --dir ../pi-tui build && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "clean": "rm -rf dist",
    "smoke": "node scripts/tarball-smoke.mjs",
    "smoke:fixture": "node scripts/extension-fixture-smoke.mjs",
    "prepack": "pnpm clean && pnpm --dir ../pi-tui clean && pnpm build:package && pnpm typecheck && pnpm test",
    "postpack": "node scripts/tarball-smoke.mjs && node scripts/extension-fixture-smoke.mjs && node scripts/advanced-plugin-smoke.mjs && node scripts/unstable-plugin-smoke.mjs && node scripts/vim-plugin-smoke.mjs",
    "smoke:advanced": "node scripts/advanced-plugin-smoke.mjs",
    "smoke:unstable": "node scripts/unstable-plugin-smoke.mjs",
    "smoke:vim": "node scripts/vim-plugin-smoke.mjs"
  }
}
