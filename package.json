{
  "name": "dsh-pi-tui",
  "version": "0.1.0",
  "private": true,
  "description": "A third-party TUI mode for DeepSeek Harness (dsh), built on a vendored pi-tui fork",
  "license": "MIT",
  "author": "XMoon <xmoonox@gmail.com>",
  "homepage": "https://github.com/XMoon/dsh-pi-tui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XMoon/dsh-pi-tui.git"
  },
  "bugs": {
    "url": "https://github.com/XMoon/dsh-pi-tui/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && node --test docs/tmux/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "pack:release": "rm -f packages/dsh-pi-tui/xmoon76-dsh-pi-tui-*.tgz && pnpm --filter @xmoon76/dsh-pi-tui pack --pack-destination packages/dsh-pi-tui",
    "smoke:pack": "pnpm --filter @xmoon76/dsh-pi-tui exec node scripts/tarball-smoke.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
