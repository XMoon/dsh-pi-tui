{
  "name": "@xmoon76/dsh-pi-tui",
  "version": "0.3.4",
  "description": "The dsh-pi-tui bundle: a TUI surface for DeepSeek Harness profiles (dsh --profile pi-tui)",
  "license": "MIT",
  "author": "XMoon <xmoonox@gmail.com>",
  "homepage": "https://github.com/XMoon/dsh-pi-tui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XMoon/dsh-pi-tui.git"
  },
  "bugs": {
    "url": "https://github.com/XMoon/dsh-pi-tui/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tui",
    "terminal",
    "cordis",
    "cli"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./startup": {
      "types": "./dist/startup.d.mts",
      "default": "./dist/startup.mjs"
    },
    "./extensions": {
      "types": "./dist/extensions.d.mts",
      "default": "./dist/extensions.mjs"
    },
    "./extensions/advanced": {
      "types": "./dist/extension/advanced.d.mts",
      "default": "./dist/extension/advanced.mjs"
    },
    "./extensions/unstable": {
      "types": "./dist/extension/unstable.d.mts",
      "default": "./dist/extension/unstable.mjs"
    },
    "./builtins": {
      "types": "./dist/builtins.d.mts",
      "default": "./dist/builtins.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^15.0.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-goal": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm-retry": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-plan-mode": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tool-workflow": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-loop": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-goal": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-jobs": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm-retry": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-plan-mode": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tool-workflow": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "@xmoon76/pi-tui": "workspace:^0.84.3",
    "@xterm/headless": "5.5.0",
    "husky": "^9.1.7",
    "tsdown": "0.22.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:fork": "pnpm --dir packages/pi-tui clean",
    "build:fork": "pnpm --dir packages/pi-tui build",
    "build:bundle": "tsdown",
    "build": "pnpm build:fork && pnpm build:bundle",
    "typecheck:fork": "pnpm --dir packages/pi-tui typecheck",
    "typecheck:bundle": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:fork && pnpm typecheck:bundle",
    "test:fork": "pnpm --dir packages/pi-tui test",
    "test:bundle": "node --test test/*.test.ts test/*.test.mjs",
    "test:docs": "node --test docs/tmux/*.test.mjs",
    "test": "pnpm test:fork && pnpm test:bundle && pnpm test:docs",
    "smoke": "node scripts/tarball-smoke.mjs",
    "smoke:fixture": "node scripts/extension-fixture-smoke.mjs",
    "smoke:advanced": "node scripts/advanced-plugin-smoke.mjs",
    "smoke:phase4": "node scripts/phase4-plugin-smoke.mjs",
    "smoke:unstable": "node scripts/unstable-plugin-smoke.mjs",
    "smoke:vim": "node scripts/vim-plugin-smoke.mjs",
    "smoke:examples": "node scripts/examples-plugin-smoke.mjs",
    "prepack": "pnpm clean && pnpm clean:fork && pnpm build && pnpm typecheck:bundle && pnpm test:bundle",
    "postpack": "node scripts/tarball-smoke.mjs && node scripts/extension-fixture-smoke.mjs && node scripts/advanced-plugin-smoke.mjs && node scripts/phase4-plugin-smoke.mjs && node scripts/unstable-plugin-smoke.mjs && node scripts/vim-plugin-smoke.mjs && node scripts/examples-plugin-smoke.mjs",
    "pack:release": "rm -f xmoon76-dsh-pi-tui-*.tgz && pnpm pack --pack-destination .",
    "smoke:pack": "node scripts/tarball-smoke.mjs",
    "verify:prepush": "pnpm typecheck:fork && pnpm test:fork && pnpm test:docs && node scripts/naming-gate.mjs && pnpm gate:boundary && pnpm audit --prod --audit-level high && pnpm pack:release",
    "verify:prepush:nofork": "pnpm test:docs && node scripts/naming-gate.mjs && pnpm gate:boundary && pnpm audit --prod --audit-level high && pnpm pack:release",
    "prepare": "husky",
    "gate:boundary": "node scripts/client-boundary-gate.mjs"
  }
}
