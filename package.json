{
	"name": "@xmoon76/dsh-pi-tui",
	"version": "0.4.0-alpha.1",
	"description": "The dsh-pi-tui bundle: a TUI surface for DeepSeek Harness profiles (dsh --profile pi-tui)",
	"license": "MIT",
	"author": "XMoon <xmoonox@gmail.com>",
	"homepage": "https://github.com/XMoon/dsh-pi-tui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/XMoon/dsh-pi-tui.git"
	},
	"bugs": {
		"url": "https://github.com/XMoon/dsh-pi-tui/issues"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"tui",
		"terminal",
		"cordis",
		"cli"
	],
	"type": "module",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./startup": {
			"types": "./dist/startup.d.mts",
			"default": "./dist/startup.mjs"
		},
		"./extensions": {
			"types": "./dist/extensions.d.mts",
			"default": "./dist/extensions.mjs"
		},
		"./extensions/advanced": {
			"types": "./dist/extension/advanced.d.mts",
			"default": "./dist/extension/advanced.mjs"
		},
		"./extensions/unstable": {
			"types": "./dist/extension/unstable.d.mts",
			"default": "./dist/extension/unstable.mjs"
		},
		"./builtins": {
			"types": "./dist/builtins.d.mts",
			"default": "./dist/builtins.mjs"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"scripts/repair-session.mjs",
		"scripts/repair-core.mjs",
		"cordis.patch.yml",
		"README.md",
		"README.en.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"dependencies": {
		"chalk": "^5.4.1",
		"commander": "^15.0.0",
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
